<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_server_sync_and_open_treasuries" model="ir.actions.server">
            <field name="name">Sync and Open Treasuries</field>
            <field name="model_id" ref="model_holded_sync_odoo_odoo_treasuries"/>
            <field name="state">code</field>
            <field name="code">
action = env['holded_sync_odoo.odoo_treasuries'].sync_treasuries_button()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Holded Treasuries',
    'res_model': 'holded_sync_odoo.odoo_treasuries',
    'view_mode': 'tree,form',
    'target': 'current',
}
            </field>
        </record>

<!--        <record model="ir.actions.act_window" id="odoo_treasuries_list_action">-->
<!--            <field name="name">Holded Treasuries</field>-->
<!--            <field name="res_model">holded_sync_odoo.odoo_treasuries</field>-->
<!--            <field name="view_mode">tree,form</field>-->
<!--            <field name="help" type="html">-->
<!--                <p class="oe_view_nocontent_create">New Treasury-->
<!--                </p>-->
<!--            </field>-->
<!--        </record>-->

        <menuitem id="odoo_treasuries_menu" name="Treasuries"
                  parent="main_holded_sync_odoo_menu"
                  action="action_server_sync_and_open_treasuries"
                  sequence="30"/>

        <record id="view_odoo_treasuries_tree" model="ir.ui.view">
            <field name="name">odoo_treasuries.tree</field>
            <field name="model">holded_sync_odoo.odoo_treasuries</field>
            <field name="arch" type="xml">
                 <tree create="false">
                    <header>
                        <button name="sync_treasuries_button" string="Synchronize" type="object" class="oe_highlight"/>
                    </header>
                    <field name="last_sync" invisible="context.get('hide_last_sync', False)"/>
                    <field name="holded_treasury_id"/>
                    <field name="name"/>
                    <field name="bic"/>
                    <field name="acc_number"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_odoo_treasuries_search">
            <field name="name">odoo_treasuries.search</field>
            <field name="model">holded_sync_odoo.odoo_treasuries</field>
            <field name="arch" type="xml">
                <search>
                </search>
            </field>
        </record>

        <record id="view_odoo_treasuries_form" model="ir.ui.view">
            <field name="name">odoo_treasuries.form</field>
            <field name="model">holded_sync_odoo.odoo_treasuries</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                             <field name="holded_treasury_id" readonly="1"/>
                             <field name="name" readonly="1"/>
                             <field name="bic" readonly="1"/>
                             <field name="acc_number" readonly="1"/>
                        </group>
                        <notebook>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
