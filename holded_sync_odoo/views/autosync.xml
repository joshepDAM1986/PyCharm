<odoo>
    <data>

        <record model="ir.actions.act_window" id="autosync_list_action">
            <field name="name">Synchronization</field>
            <field name="res_model">holded_sync_odoo.autosync</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Synchronization</p>
            </field>
            <field name="context">{'button_sync_visible': True}</field>
        </record>

        <menuitem id="autosync_menu" name="Sync All"
                  parent="main_holded_sync_odoo_menu"
                  action="action_server_autosync"
                  sequence="100"/>

        <record id="view_autosync_tree" model="ir.ui.view">
            <field name="name">autosync.tree</field>
            <field name="model">holded_sync_odoo.autosync</field>
            <field name="arch" type="xml">
                <tree>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_autosync_search">
            <field name="name">autosync.search</field>
            <field name="model">holded_sync_odoo.autosync</field>
            <field name="arch" type="xml">
                <search>
                </search>
            </field>
        </record>

        <record id="view_autosync_form" model="ir.ui.view">
            <field name="name">autosync.form</field>
            <field name="model">holded_sync_odoo.autosync</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_server_autosync" model="ir.actions.server">
            <field name="name">Sync All</field>
            <field name="model_id" ref="model_holded_sync_odoo_autosync"/>
            <field name="state">code</field>
            <field name="code">
                action = env['holded_sync_odoo.autosync'].autosync_everything_button()
            </field>
        </record>

    </data>
</odoo>
