        <!-- Acción de ventana para listar los pagos -->
        <record model="ir.actions.act_window" id="odoo_payments_list_action">
            <field name="name">Sync Payments</field>
            <field name="res_model">holded_sync_odoo.odoo_payments</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">New Payment</p>
            </field>
            <field name="context">{'button_sync_visible': True}</field>
