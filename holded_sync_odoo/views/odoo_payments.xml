<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Acción de ventana para la lista de pagos -->
        <record model="ir.actions.act_window" id="odoo_payments_list_action">
            <field name="name">Holded Payments</field>
            <field name="res_model">holded_sync_odoo.odoo_payments</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">New Payment</p>
            </field>
            <field name="context">{'button_sync_visible': True}</field>
        </record>

        <!-- Menú para acceder a los pagos -->
        <menuitem id="odoo_payments_menu" name="Payments"
                  parent="main_holded_sync_odoo_menu"
                  action="odoo_payments_list_action"
                  sequence="50"/>

        <!-- Vista de árbol para el modelo de pagos -->
        <record id="view_odoo_payments_tree" model="ir.ui.view">
            <field name="name">odoo_payments.tree</field>
            <field name="model">holded_sync_odoo.odoo_payments</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="last_sync" invisible="context.get('hide_last_sync', False)"/>
                    <button name="sync_payments_button" string="Synchronize" type="object" class="btn-primary"/>
                </tree>
                <tree>
                    <field name="odoo_document_id"/>
                    <field name="odoo_payment_id"/>
                    <field name="holded_payment_id"/>
                    <field name="bankId"/>
                    <field name="contactId"/>
                    <field name="contactName"/>
                    <field name="amount"/>
                    <field name="date"/>
                    <field name="documentId"/>
                </tree>
            </field>
        </record>


        <!-- Vista de búsqueda para el modelo de pagos -->
        <record id="view_odoo_payments_search" model="ir.ui.view">
            <field name="name">odoo_payments.search</field>
            <field name="model">holded_sync_odoo.odoo_payments</field>
            <field name="arch" type="xml">
                <search>
                    <!-- Se puede añadir filtros de búsqueda aquí si es necesario -->
                </search>
            </field>
        </record>

        <!-- Vista de formulario para el modelo de pagos -->
        <record id="view_sync_payment_form" model="ir.ui.view">
            <field name="name">odoo_payments.form</field>
            <field name="model">holded_sync_odoo.odoo_payments</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="odoo_document_id" readonly="1"/>
                            <field name="odoo_payment_id" readonly="1"/>
                            <field name="holded_payment_id" readonly="1"/>
                            <field name="bankId" readonly="1"/>
                            <field name="contactId" readonly="1"/>
                            <field name="contactName" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="documentId" readonly="1"/>
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
