<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
          <record model="ir.actions.act_window" id="task_list_action">
            <field name="name">Tareas</field>
            <field name="res_model">gestion_proyectos.tarea</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="task_menu" name="Tareas"
                  parent="main_gestion_proyectos_menu"
                  action="task_list_action"/>

        <record id="view_task_tree" model="ir.ui.view">
            <field name="name">tarea.tree</field>
            <field name="model">gestion_proyectos.tarea</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="descripcion"/>
                    <field name="vencimiento"/>
                    <field name="completado"/>
                    <field name="socios_nombres"/>
                    <field name="proyecto_id"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_task_search">
        <field name="name">gestion_proyectos.search</field>
        <field name="model">gestion_proyectos.tarea</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="descripcion"/>
            </search>
        </field>
        </record>

        <record id="view_task_form" model="ir.ui.view">
            <field name="name">task.form</field>
            <field name="model">gestion_proyectos.tarea</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="nombre"/>
                            <field name="descripcion"/>
                            <field name="vencimiento"/>
                            <field name="completado"/>
                            <field name="socios_ids"/>
                            <field name="proyecto_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>