<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_odoo2holded_apikeyconfig" model="ir.actions.act_window">
            <field name="name">Configuration</field>
            <field name="res_model">odoo2holded.apikeyconfig</field>
            <field name="view_mode">tree,form</field>
            <field name="target">current</field>
        </record>

        <menuitem id="menu_odoo2holded_apikeyconfig" name="Configuration"
                  parent="main_odoo2holded_menu"
                  action="action_odoo2holded_apikeyconfig"
                  sequence="90"/>

        <record id="view_odoo2holded_apikeyconfig_tree" model="ir.ui.view">
            <field name="name">odoo2holded.apikeyconfig.tree</field>
            <field name="model">odoo2holded.apikeyconfig</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="api_key"/>
                    <field name="interval_number"/>
                    <field name="interval_type"/>
                    <field name="nextcall"/>
                    <field name="numbercall"/>
                </tree>
            </field>
        </record>

        <record id="view_odoo2holded_apikeyconfig_form" model="ir.ui.view">
            <field name="name">odoo2holded.apikeyconfig.form</field>
            <field name="model">odoo2holded.apikeyconfig</field>
            <field name="arch" type="xml">
                <form string="Configuration">
                    <group>
                        <field name="api_key"/>
                        <field name="interval_number"/>
                        <field name="interval_type"/>
                        <field name="nextcall"/>
                        <field name="numbercall"/>
                        <button string="Save" type="object" name="save_api_key" class="btn-primary"/>
                    </group>
                </form>
            </field>
        </record>
    </data>
</odoo>
