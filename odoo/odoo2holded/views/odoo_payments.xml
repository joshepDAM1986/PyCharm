<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_server_sync_and_open_payments" model="ir.actions.server">
            <field name="name">Sync and Open Payments</field>
            <field name="model_id" ref="model_odoo2holded_odoo_payments"/>
            <field name="state">code</field>
            <field name="code">
action = env['odoo2holded.odoo_payments'].sync_payments_button()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Holded Payments',
    'res_model': 'odoo2holded.odoo_payments',
    'view_mode': 'tree,form',
    'target': 'current',
}
            </field>
        </record>

<!--        <record model="ir.actions.act_window" id="odoo_payments_list_action">-->
<!--            <field name="name">Holded Payments</field>-->
<!--            <field name="res_model">odoo2holded.odoo_payments</field>-->
<!--            <field name="view_mode">tree,form</field>-->
<!--            <field name="help" type="html">-->
<!--                <p class="oe_view_nocontent_create">New Payment-->
<!--                </p>-->
<!--            </field>-->
<!--        </record>-->

        <menuitem id="odoo_payments_menu" name="Payments"
                  parent="main_odoo2holded_menu"
                  action="action_server_sync_and_open_payments"
                  sequence="50"/>

        <record id="view_odoo_payments_tree" model="ir.ui.view">
            <field name="name">odoo_payments.tree</field>
            <field name="model">odoo2holded.odoo_payments</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <header>
                        <button name="sync_payments_button" string="Synchronize" type="object" class="oe_highlight"/>
                    </header>
                    <field name="last_sync" invisible="context.get('hide_last_sync', False)"/>
                    <field name="odoo_document_name"/>
                    <field name="odoo_payment_name"/>
                    <field name="bankId"/>
                    <field name="contactName"/>
                    <field name="amount"/>
                    <field name="date"/>
                </tree>
            </field>
        </record>

        <record id="view_odoo_payments_search" model="ir.ui.view">
            <field name="name">odoo_payments.search</field>
            <field name="model">odoo2holded.odoo_payments</field>
            <field name="arch" type="xml">
                <search>
                </search>
            </field>
        </record>

        <record id="view_sync_payment_form" model="ir.ui.view">
            <field name="name">odoo_payments.form</field>
            <field name="model">odoo2holded.odoo_payments</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="documentId" readonly="1"/>
                            <field name="odoo_document_id" readonly="1"/>
                            <field name="odoo_document_name" readonly="1"/>
                            <field name="holded_payment_id" readonly="1"/>
                            <field name="odoo_payment_id" readonly="1"/>
                            <field name="odoo_payment_name" readonly="1"/>
                            <field name="bankId" readonly="1"/>
                            <field name="contactId" readonly="1"/>
                            <field name="contactName" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="date" readonly="1"/>
                            <field name="documentId" readonly="1"/>
                        </group>
                        <notebook>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>
