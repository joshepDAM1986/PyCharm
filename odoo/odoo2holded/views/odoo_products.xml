<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_server_sync_and_open_products" model="ir.actions.server">
            <field name="name">Sync and Open Products</field>
            <field name="model_id" ref="model_odoo2holded_odoo_products"/>
            <field name="state">code</field>
            <field name="code">
action = env['odoo2holded.odoo_products'].sync_products_button()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Holded Products',
    'res_model': 'odoo2holded.odoo_products',
    'view_mode': 'tree,form',
    'target': 'current',
}
            </field>
        </record>

<!--        <record model="ir.actions.act_window" id="odoo_products_list_action">-->
<!--            <field name="name">Holded Products</field>-->
<!--            <field name="res_model">odoo2holded.odoo_products</field>-->
<!--            <field name="view_mode">tree,form</field>-->
<!--            <field name="help" type="html">-->
<!--                <p class="oe_view_nocontent_create">New Product-->
<!--                </p>-->
<!--            </field>-->
<!--        </record>-->

        <menuitem id="main_odoo2holded_menu" name="Odoo2Holded" action="action_server_sync_and_open_products"/>
        <menuitem id="odoo_products_menu" name="Products"
                  parent="main_odoo2holded_menu"
                  action="action_server_sync_and_open_products"
                  sequence="10"/>

        <record id="view_odoo_products_tree" model="ir.ui.view">
            <field name="name">odoo_products.tree</field>
            <field name="model">odoo2holded.odoo_products</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <header>
                        <button name="sync_products_button" string="Synchronize" type="object"/>
                    </header>
                    <field name="last_sync" invisible="context.get('hide_last_sync', False)"/>
                    <field name="sku"/>
                    <field name="name"/>
                    <field name="purchasePrice"/>
                    <field name="price"/>
                    <field name="barcode"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_odoo_products_search">
            <field name="name">odoo_products.search</field>
            <field name="model">odoo2holded.odoo_products</field>
            <field name="arch" type="xml">
                <search>
                </search>
            </field>
        </record>

        <record id="view_odoo_products_form" model="ir.ui.view">
            <field name="name">odoo_products.form</field>
            <field name="model">odoo2holded.odoo_products</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="holded_product_id" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="kind" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="purchasePrice" readonly="1"/>
                            <field name="price" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                        </group>
                        <notebook>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>