<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="project_list_action">
            <field name="name">Proyectos</field>
            <field name="res_model">gestion_proyectos.proyecto</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Nuevo proyecto
                </p>
            </field>
        </record>

        <record id="view_project_tree" model="ir.ui.view">
            <field name="name">proyecto.tree</field>
            <field name="model">gestion_proyectos.proyecto</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nombre"/>
                    <field name="descripcion"/>
                    <field name="imagen" widget="image" options="{'size': [100, 100]}"/>
                    <field name="prioridad"/>
                    <field name="usuario_id" widget="badge"/>
                    <field name="tareas_ids" widget="many2many_tags"/>
                    <field name="tareas_completadas"/>
                    <field name="progreso"/>
                    <field name="presupuestos_relacionados" widget="many2many_tags"/>
                    <field name="total_presupuestos" widget="badge"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_project_search">
        <field name="name">proyecto.search</field>
        <field name="model">gestion_proyectos.proyecto</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="descripcion"/>
                <field name="prioridad"/>

            </search>
        </field>
        </record>

        <record id="view_project_form" model="ir.ui.view">
            <field name="name">proyecto.form</field>
            <field name="model">gestion_proyectos.proyecto</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="nombre"/>
                            <field name="descripcion"/>
                            <field name="imagen" widget="image" options="{'size': [150, 150]}"/>
                            <field name="prioridad"/>
                            <field name="usuario_id"/>
                            <field name="tareas_ids" widget="many2many_tags" readonly="1"/>
                            <field name="tareas_completadas" readonly="1"/>
                            <field name="progreso" readonly="1"/>
                            <field name="presupuestos_relacionados" widget="many2many_tags" readonly="1"/>
                            <field name="total_presupuestos" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Tareas del Proyecto">
                                <field name="tareas_ids" widget="many2many_tags"/>
                            </page>
                            <page string="Presupuestos del Proyecto">
                                <field name="presupuestos_relacionados" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

       <menuitem id="main_gestion_proyectos_menu" name="Gestión de Proyectos" action="project_list_action"/>
       <menuitem id="project_menu" name="Proyectos" parent="main_gestion_proyectos_menu" action="project_list_action"/>

    </data>
</odoo>