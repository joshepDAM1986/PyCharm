<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.actions.act_window" id="custom_products_list_action">
            <field name="name">Custom Products</field>
            <field name="res_model">holded_sync_odoo.custom_products</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">New Product</p>
            </field>
            <field name="context">{'button_sync_visible': True}</field>
        </record>

        <record id="view_custom_products_tree" model="ir.ui.view">
            <field name="name">custom_products.tree</field>
            <field name="model">holded_sync_odoo.custom_products</field>
            <field name="arch" type="xml">
                <tree>
                    <button name="sync_custom_products_button" string="Sync Products" type="object" class="btn-primary"/>
                    <field name="holded_id"/>
                    <field name="sku"/>
                    <field name="kind"/>
                    <field name="name"/>
                    <field name="desc"/>
                    <field name="price"/>
                    <field name="total"/>
                </tree>
            </field>
        </record>

        <record id="view_custom_products_form" model="ir.ui.view">
            <field name="name">custom_products.form</field>
            <field name="model">holded_sync_odoo.custom_products</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="holded_id" readonly="1"/>
                            <field name="sku"/>
                            <field name="kind"/>
                            <field name="name"/>
                            <field name="desc"/>
                            <field name="price"/>
                            <field name="total"/>
                        </group>
                        <notebook>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_custom_products_search">
            <field name="name">custom_products.search</field>
            <field name="model">holded_sync_odoo.custom_products</field>
            <field name="arch" type="xml">
                <search>

                </search>
            </field>
        </record>

