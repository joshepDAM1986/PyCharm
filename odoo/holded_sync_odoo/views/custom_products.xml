<!--            <field name="numbercall">-1</field>-->
<!--            <field name="code">model._cron_sync_products()</field>-->
<!--            <field eval="True" name="active"/>-->
<!--        </record>-->

        <menuitem id="main_holded_sync_odoo_menu" name="Holded Sync Odoo" action="custom_products_list_action"/>
        <menuitem id="custom_products_menu" name="Custom Products" parent="main_holded_sync_odoo_menu" action="custom_products_list_action"/>
    </data>
</odoo>